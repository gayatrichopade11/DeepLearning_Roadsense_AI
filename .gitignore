!.env.example

# Frontend build outputs
dist/
dist-ssr/
*.local

# Backend runtime storage & uploads
backend/uploads/*
!backend/uploads/.gitkeep

# Machine Learning datasets & training runs
ml/dataset/
ml/runs/

# Pretrained base model downloads in root (Ultralytics auto-downloads)
/yolov8n.pt

